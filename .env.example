# Example environment file for local Compose / binary runs.
#
# Copy to .env (gitignored) and fill secrets:
#   cp .env.example .env
#
# scripts/install.sh and podman compose read .env when present.
# Prefer config.yaml for structured settings; use .env for secrets.

# GITSEER_SERVER_EXTERNAL_URL=http://127.0.0.1:8090
# GITSEER_GITEA_URL=https://git.example.com
# GITSEER_GITEA_TOKEN=
# GITSEER_WEBHOOK_SECRET=
# GITSEER_ENCRYPTION_KEY=
# GITSEER_GITHUB_URL=https://github.com
# GITSEER_GITHUB_TOKEN=
# GITSEER_GITHUB_WEBHOOK_SECRET=
# GITSEER_AUTH_OAUTH_CLIENT_ID=
# GITSEER_AUTH_OAUTH_CLIENT_SECRET=
# GITSEER_GITEA_ALLOW_PRIVATE_NETWORK=false
# GITSEER_ALLOW_SKIP_SETUP=true
# GITSEER_AUTH_COOKIE_SECURE=false
# GITSEER_METRICS_TOKEN=
